#!/bin/bash
# swayosd (volume/brightness popups): ~/.config/swayosd/style.css.
src=~/.local/state/cc/theme/swayosd.css
[[ -f $src ]] || exit 0
mkdir -p ~/.config/swayosd
cp -f "$src" ~/.config/swayosd/style.css

# Match the desktop's actual corner rounding, not whatever radius (or lack
# of one) the theme's own swayosd.css shipped with: themes without a
# swayosd.css fall back to this template, which sets no border-radius, so
# they inherited swayosd's built-in rounded default even when the theme
# itself is square (rounding = 0). Appending wins the CSS cascade over any
# earlier .osd rule, theme-shipped or templated.
if command -v hyprctl >/dev/null && [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
  rounding=$(hyprctl getoption decoration:rounding -j 2>/dev/null | jq -r '.int // 0')
  printf '\n.osd,\nosd {\n    border-radius: %spx;\n}\n' "${rounding:-0}" >>~/.config/swayosd/style.css
fi

pkill -x swayosd-server 2>/dev/null
systemctl --user restart cc-swayosd.service
exit 0

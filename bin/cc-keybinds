#!/bin/bash
# Searchable list of every bind that has a description.
hyprctl binds -j | jq -r '
  def mods: [ (if .modmask % 128 >= 64 then "SUPER" else empty end),
              (if .modmask % 8 >= 4 then "CTRL" else empty end),
              (if .modmask % 16 >= 8 then "ALT" else empty end),
              (if .modmask % 2 >= 1 then "SHIFT" else empty end) ];
  .[] | select(.has_description) | "\((mods + [.key]) | join(" + "))  →  \(.description)"' \
  | cc-dmenu "Keybindings" >/dev/null

#!/usr/bin/env bash
# Bar/dock switch for whichever waybar theme is live.
#   cc-waybar-mode           print the Bar/Dock label (waybar custom module)
#   cc-waybar-mode toggle    swap to the other layout and reload waybar
#
# The live config.jsonc/style.css are symlinks into a theme. The layout is
# whichever configs/<mode>.jsonc the link points at, so nothing is stored and
# nothing is written through the link (a cp would overwrite the theme file).
# Themes without a configs/ + styles/ bar/dock pair show no toggle.

live_config="$HOME/.config/waybar/config.jsonc"
live_style="$HOME/.config/waybar/style.css"

emit() { printf '{"text": "%s", "tooltip": "%s", "class": "%s"}\n' "$1" "$2" "$3"; }

# Sets theme and mode from the live links; fails when there is no bar/dock pair.
resolve() {
  [[ -L $live_config && -L $live_style ]] || return 1
  local target dir
  target=$(readlink -f "$live_config")
  dir=$(dirname "$target")
  if [[ $(basename "$dir") == configs ]]; then
    theme=$(dirname "$dir")
    mode=$(basename "$target" .jsonc)
  else
    theme=$dir
    mode=bar # a theme's top-level config.jsonc is its bar layout
  fi
  [[ -f $theme/configs/bar.jsonc && -f $theme/configs/dock.jsonc &&
     -f $theme/styles/bar.css && -f $theme/styles/dock.css ]]
}

case "${1:-status}" in
  toggle)
    resolve || exit 0
    if [[ $mode == bar ]]; then next=dock; else next=bar; fi
    ln -sfn "$theme/configs/$next.jsonc" "$live_config"
    ln -sfn "$theme/styles/$next.css" "$live_style"
    pkill -USR2 -x waybar
    ;;
  *)
    if resolve; then
      if [[ $mode == bar ]]; then emit "Bar" "Switch to dock style" ""
      else emit "Dock" "Switch to bar style" ""; fi
    else
      emit "" "" ""
    fi
    ;;
esac

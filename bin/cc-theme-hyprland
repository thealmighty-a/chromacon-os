#!/usr/bin/env python3
"""Translate a theme's Hyprland look (hyprland.conf + hyprland_animations.conf,
hyprlang syntax) into ~/.config/hypr/cc's Lua config.

  cc-theme-hyprland <staged-theme-dir>

Writes <dir>/hypr-theme.lua: a Lua table of data only (no code from the
theme runs). looknfeel.lua applies it after ChromaCon's defaults, skipping any
option this Hyprland doesn't know. Handled: $variables, nested sections
(general, decoration, blur, shadow, group, groupbar, misc...), gradient
colours, bezier curves, animations and layer rules. Keybinds, exec/source
lines and window rules are ignored.
"""
import re
import sys
from pathlib import Path

GRADIENT = re.compile(r"^((?:rgba?\([^)]*\)|0x[0-9a-fA-F]{6,8})\s*)+(-?\d+(?:\.\d+)?deg)?$")
COLOR = re.compile(r"rgba?\([^)]*\)|0x[0-9a-fA-F]{6,8}")
SKIP_TOP = {"bind", "bindd", "binde", "bindl", "bindm", "bindel", "bindr", "unbind", "exec", "exec-once",
            "source", "windowrule", "windowrulev2", "env", "monitor", "workspace", "plugin"}


def lua_value(raw: str, key: str = "") -> str:
    v = raw.strip()
    if key.endswith(("gaps_in", "gaps_out", "gaps_workspaces")):
        nums = re.findall(r"-?\d+", v)
        if len(nums) == 1:
            return nums[0]
        if len(nums) == 2:
            nums = [nums[0], nums[1], nums[0], nums[1]]
        if len(nums) >= 4:
            return "{ top = %s, right = %s, bottom = %s, left = %s }" % tuple(nums[:4])
    low = v.lower()
    if low in ("true", "yes", "on"):
        return "true"
    if low in ("false", "no", "off"):
        return "false"
    if re.fullmatch(r"-?\d+", v):
        return v
    if re.fullmatch(r"-?\d*\.\d+", v):
        return v
    if re.fullmatch(r"0x[0-9a-fA-F]{6,8}", v):
        return str(int(v, 16))
    m = GRADIENT.match(v)
    if m and (len(COLOR.findall(v)) > 1 or m.group(2)):
        colors = ", ".join(f'"{c}"' for c in COLOR.findall(v))
        angle = m.group(2)
        return "{ colors = { %s }%s }" % (colors, f", angle = {angle[:-3]}" if angle else "")
    return '"' + v.replace("\\", "\\\\").replace('"', '\\"') + '"'


def parse(text: str):
    variables = {}
    options, curves, animations, layer_rules = [], [], [], []
    stack = []
    block_rule = None
    # Put braces on their own lines ("}general {" and "a { b = 1 }" both occur).
    text = re.sub(r"\{", "{\n", re.sub(r"\}", "\n}\n", text))
    for raw in text.splitlines():
        line = raw.split("#", 1)[0].strip()
        if not line:
            continue
        if line.endswith("{"):
            name = line[:-1].strip()
            if name == "layerrule" and not stack:
                block_rule = {}
            stack.append(name)
            continue
        if line == "}":
            if stack and stack[-1] == "layerrule" and block_rule is not None and len(stack) == 1:
                layer_rules.append(block_rule)
                block_rule = None
            if stack:
                stack.pop()
            continue
        if "=" not in line:
            continue
        key, value = (part.strip() for part in line.split("=", 1))
        value = value.rstrip(";").strip()
        if key.startswith("$"):
            variables[key] = value
            continue
        for var in sorted(variables, key=len, reverse=True):
            value = value.replace(var, variables[var])
        if "$" in value:
            continue  # refers to a variable the theme doesn't define (Omarchy's own)

        if block_rule is not None and stack == ["layerrule"]:
            block_rule[key] = value
        elif key == "bezier":
            parts = [p.strip() for p in value.split(",")]
            if len(parts) == 5:
                curves.append((parts[0], parts[1:]))
        elif key == "animation":
            parts = [p.strip() for p in value.split(",")]
            if len(parts) >= 3:
                animations.append(parts)
        elif key == "layerrule" and not stack:
            rule = {}
            for part in (p.strip() for p in value.split(",")):
                if part.startswith("match:"):
                    mkey, _, mval = part[6:].partition(" ")
                    rule["match:" + mkey] = mval.strip()
                elif part:
                    prop, _, pval = part.partition(" ")
                    rule[prop] = pval.strip() or "on"
            layer_rules.append(rule)
        elif not stack and key in SKIP_TOP:
            continue
        elif stack and stack[0] in ("animations",) and key == "enabled":
            options.append(("animations.enabled", value))
        elif stack:
            options.append((".".join(stack + [key]), value))
    return options, curves, animations, layer_rules


def render(options, curves, animations, layer_rules) -> str:
    out = ["-- Generated by cc-theme-hyprland from the theme's hyprland*.conf. Data only.", "return {", "  options = {"]
    for key, value in options:
        out.append(f'    {{ "{key}", {lua_value(value, key)} }},')
    out += ["  },", "  curves = {"]
    for name, pts in curves:
        out.append(f'    {{ "{name}", {{ {{ {pts[0]}, {pts[1]} }}, {{ {pts[2]}, {pts[3]} }} }} }},')
    out += ["  },", "  animations = {"]
    for parts in animations:
        leaf, enabled, speed = parts[0], lua_value(parts[1]), parts[2]
        if enabled == "1":
            enabled = "true"
        elif enabled == "0":
            enabled = "false"
        fields = [f'leaf = "{leaf}"', f"enabled = {enabled}"]
        if re.fullmatch(r"-?\d+(\.\d+)?", speed):
            fields.append(f"speed = {speed}")
        if len(parts) > 3 and parts[3]:
            fields.append(f'bezier = "{parts[3]}"')
        if len(parts) > 4 and parts[4]:
            fields.append(f'style = "{", ".join(parts[4:])}"')
        out.append("    { " + ", ".join(fields) + " },")
    out += ["  },", "  layer_rules = {"]
    for rule in layer_rules:
        match = {k[6:]: v for k, v in rule.items() if k.startswith("match:")}
        props = {k: v for k, v in rule.items() if not k.startswith("match:") and k != "name"}
        if not match:
            continue
        m = ", ".join(f'{k} = "{v}"' for k, v in match.items())
        p = ", ".join(f"{k} = {lua_value(v)}" for k, v in props.items())
        out.append(f"    {{ match = {{ {m} }}, {p} }},")
    out += ["  },", "}"]
    return "\n".join(out) + "\n"


def main() -> int:
    if len(sys.argv) != 2:
        print(__doc__, file=sys.stderr)
        return 1
    theme = Path(sys.argv[1])
    text = ""
    for name in ("hyprland.conf", "hyprland_animations.conf"):
        f = theme / name
        if f.is_file() and not f.is_symlink():
            text += f.read_text(errors="ignore") + "\n"
    (theme / "hypr-theme.lua").write_text(render(*parse(text)))
    return 0


if __name__ == "__main__":
    sys.exit(main())
